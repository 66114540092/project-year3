title UC-07: Manage Lobby (จัดการห้องแข่ง - Host)

actor "Host (Member)" as H
participant "LobbyPage" as UI <<Template>>
participant "TournamentViews" as V <<View>>
participant "Tournament" as T <<Model>>
participant "Match" as M <<Model>>
database "PostgreSQL" as DB

group Open Lobby
    H -> UI : Click "Open Waiting Lobby"
    activate UI
    UI -> V : POST /tournaments/{id}/open_lobby/
    activate V
        V -> T : get_object_or_404(pk, user)
        activate T
        deactivate T
        
        V -> V : generate_pin_code() (Loop until unique)
        activate V
        deactivate V
        
        V -> T : pin_code = pin
        activate T
        deactivate T
        V -> T : status = 'waiting'
        activate T
        deactivate T
        V -> T : save()
        activate T
            T -> DB : UPDATE tournament
            activate DB
            DB --> T : Success
            deactivate DB
        deactivate T
        
        V --> UI : Redirect to Waiting Lobby
    deactivate V
    UI --> H : Show Lobby with PIN
    deactivate UI
end

group Start Tournament
    H -> UI : Click "Start Tournament"
    activate UI
    UI -> V : POST /tournaments/{id}/start/
    activate V
        V -> T : matches.all().delete() (Clear old)
        activate T
        T -> DB : DELETE FROM tournaments_match
        activate DB
        DB --> T : Deleted
        deactivate DB
        deactivate T
        
        loop Create Round 1 Matches
            V -> M : Match.objects.create(c1, c2, round=1)
            activate M
                M -> DB : INSERT tournaments_match
                activate DB
                DB --> M : Created
                deactivate DB
            deactivate M
        end
        
        V -> T : status = 'open'
        activate T
        deactivate T
        V -> T : current_round = 1
        activate T
        deactivate T
        V -> T : save()
        activate T
            T -> DB : UPDATE tournament
            activate DB
            DB --> T : Success
            deactivate DB
        deactivate T
        
        V --> UI : Redirect to Play Page
    deactivate V
    UI --> H : Show Match Interface
    deactivate UI
end

@enduml

