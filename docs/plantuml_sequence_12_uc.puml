title UC-08: Play & Vote (แข่งขันและโหวต)

actor "Player" as P
participant "PlayPage" as UI <<Template>>
participant "AJAX (JS)" as JS <<Script>>
participant "TournamentViews" as V <<View>>
participant "MatchVote" as MV <<Model>>
participant "Match" as M <<Model>>
database "PostgreSQL" as DB

== การส่งผลโหวต (Submit Vote) ==
P -> UI : Click Vote Option (1 or 2)
activate UI
UI -> JS : fetch('/vote_submit/')
activate JS
    JS -> V : POST /vote_submit/{match_id}/
    activate V
        V -> MV : update_or_create(match, user)
        activate MV
            MV -> DB : SELECT ...
            activate DB
            DB --> MV : Result
            deactivate DB
            
            alt Not Exists
                MV -> DB : INSERT match_vote
                activate DB
                DB --> MV : Created
                deactivate DB
            else Exists
                MV -> DB : UPDATE match_vote
                activate DB
                DB --> MV : Updated
                deactivate DB
            end
        deactivate MV
        V --> JS : JSON {success: true}
    deactivate V
    JS -> UI : Update UI (Highlight Selection)
deactivate JS
deactivate UI

== การอัปเดตคะแนน (Polling Loop) ==
loop Every 2 Seconds
    JS -> V : GET /vote_update/{match_id}/
    activate JS
    activate V
        V -> M : votes.filter(choice='1').count()
        activate M
        M -> DB : SELECT COUNT(*) ...
        activate DB
        DB --> M : Count 1
        deactivate DB
        deactivate M
        
        V -> M : votes.filter(choice='2').count()
        activate M
        M -> DB : SELECT COUNT(*) ...
        activate DB
        DB --> M : Count 2
        deactivate DB
        deactivate M
        
        V -> V : Check Time Remaining
        activate V
        
        opt Time Expired (Auto-Finish)
            V -> M : winner = max(votes)
            activate M
            deactivate M
            V -> M : is_finished = True
            activate M
            deactivate M
            V -> M : save()
            activate M
                M -> DB : UPDATE match
                activate DB
                DB --> M : Saved
                deactivate DB
            deactivate M
        end
        deactivate V
        
        V --> JS : JSON {votes, time, match_status}
    deactivate V
    JS -> UI : Update Progress Bars / Timer
    deactivate JS
end

@enduml

@startuml UC-09_Report_Issue

skinparam defaultFontName "Tahoma"
