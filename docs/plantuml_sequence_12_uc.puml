title UC-02: Search Tournaments (ค้นหาทัวร์นาเมนต์)

actor "Guest" as G
participant "TournamentListPage" as UI <<Template>>
participant "TournamentViews" as V <<View>>
participant "Tournament" as T <<Model>>
database "PostgreSQL" as DB

G -> UI : Enter Search Query / Select Filter
activate UI
UI -> V : GET /tournaments/?search=...&tag=...
activate V
    V -> T : objects.all().order_by('-created_at')
    activate T
    T -> DB : SELECT * FROM tournaments_tournament ORDER BY created_at DESC
    activate DB
    DB --> T : QuerySet (All)
    deactivate DB
    deactivate T
    
    opt Search Query Exists
        V -> T : filter(Q(name__icontains) | Q(desc__icontains))
        activate T
        T -> DB : SELECT ... WHERE name LIKE %...%
        activate DB
        DB --> T : Filtered QuerySet
        deactivate DB
        deactivate T
    end
    
    opt Tag Selected
        V -> T : filter(category=tag)
        activate T
        T -> DB : SELECT ... WHERE category = ...
        activate DB
        DB --> T : Filtered QuerySet
        deactivate DB
        deactivate T
    end
    
    V -> V : Paginator(tournaments, 12)
    activate V
    deactivate V
    
    V --> UI : Render "tournament_list.html" with page_obj
deactivate V
UI --> G : Display Search Results
deactivate UI

@enduml

