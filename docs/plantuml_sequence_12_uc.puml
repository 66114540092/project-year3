title UC-04: Manage Profile (จัดการข้อมูลส่วนตัว)

actor "Member" as M
participant "EditProfilePage" as UI <<Template>>
participant "AccountsViews" as V <<View>>
participant "ProfileUpdateForm" as UF <<UserForm>>
participant "ProfileForm" as PF <<ProfileForm>>
participant "User" as U <<Model>>
participant "Profile" as P <<Model>>
database "PostgreSQL" as DB

M -> UI : Submit Edit Profile (Avatar, Bio, Email)
activate UI
UI -> V : POST /accounts/profile/edit/
activate V
    
    V -> UF : ProfileUpdateForm(request.POST, instance=user)
    activate UF
    deactivate UF
    
    V -> PF : ProfileForm(request.POST, FILES, instance=profile)
    activate PF
    deactivate PF
    
    V -> UF : is_valid()
    activate UF
    deactivate UF
    
    V -> PF : is_valid()
    activate PF
    deactivate PF
    
    alt Both Forms Valid
        V -> UF : save()
        activate UF
        UF -> U : save()
        activate U
            U -> DB : UPDATE auth_user SET email=..., first_name=...
            activate DB
            DB --> U : Success
            deactivate DB
        deactivate U
        deactivate UF
        
        V -> PF : save()
        activate PF
        PF -> P : save()
        activate P
            P -> DB : UPDATE accounts_profile SET bio=..., avatar=...
            activate DB
            DB --> P : Success
            deactivate DB
        deactivate P
        deactivate PF
        
        V -> V : messages.success("Profile updated")
        activate V
        deactivate V
        V --> UI : Redirect to Profile Page
    else Form Invalid
        V --> UI : Re-render with Errors
    end
