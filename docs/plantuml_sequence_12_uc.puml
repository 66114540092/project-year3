@startuml UC-01_Register_Login

skinparam defaultFontName "Tahoma"
skinparam shadowing false
skinparam backgroundColor White
skinparam sequence {
    ArrowColor #333333
    LifeLineBorderColor #555555
    ParticipantBackgroundColor #E3F2FD
    ParticipantBorderColor #1565C0
    ActorBackgroundColor #E3F2FD
    ActorBorderColor #1565C0
}

title UC-01: Register & Login (สมัครและเข้าสู่ระบบ)

actor "Guest" as G
participant "SignUp/LoginPage" as UI <<Template>>
participant "AccountsViews" as V <<View>>
participant "CustomSignUpForm" as F <<Form>>
participant "User" as U <<Model>>
participant "Profile" as P <<Model>>
database "PostgreSQL" as DB

== ส่วนการสมัครสมาชิก (Register) ==

G -> UI : Submit Registration Form
activate UI
UI -> V : POST /accounts/signup/
activate V
    V -> F : CustomSignUpForm(request.POST)
    activate F
    F -> F : is_valid()
    activate F
        F -> U : validate_unique()
        activate U
        U -> DB : Check username/email
        activate DB
        DB --> U : Result
        deactivate DB
        deactivate U
    deactivate F
    deactivate F

    V -> F : save()
    activate F
    F -> U : save()
    activate U
        U -> DB : INSERT auth_user
        activate DB
        DB --> U : User Created (ID)
        deactivate DB
        
        note right of U : Signal: post_save
        U -> P : create_user_profile(sender, instance, created)
        activate P
            P -> DB : INSERT accounts_profile
            activate DB
            DB --> P : Profile Must Exist
            deactivate DB
        deactivate P
    deactivate U
    F --> V : User Object
    deactivate F
    
    V -> V : login(request, user)
    activate V
    deactivate V
    
    V --> UI : Redirect to TournamentList
deactivate V
UI --> G : Success Message
deactivate UI

== ส่วนการเข้าสู่ระบบ (Login) ==

G -> UI : Submit Login Form
activate UI
UI -> V : POST /accounts/login/
activate V
    V -> U : authenticate(username, password)
    activate U
        U -> DB : SELECT * FROM auth_user WHERE username=...
        activate DB
        DB --> U : User Record
        deactivate DB
        U -> U : check_password(hash)
        activate U
        deactivate U
    deactivate U
    
    alt Login Success
        V -> V : login(request, user)
        activate V
        deactivate V
        V --> UI : Redirect to Dashboard
    else Login Failed
        V --> UI : Return Error "Invalid credentials"
    end
deactivate V
UI --> G : Show Dashboard / Error
deactivate UI

@enduml

