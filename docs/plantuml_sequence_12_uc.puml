title UC-09: Report Issue (รายงานปัญหา)

actor "Member" as M
participant "ReportModal" as UI <<Template>>
participant "AJAX (JS)" as JS <<Script>>
participant "AdminViews" as V <<View>>
participant "Report" as R <<Model>>
database "PostgreSQL" as DB

M -> UI : Click "Flag" Icon & Submit Reason
activate UI
UI -> JS : submitReport()
activate JS
    JS -> V : POST /report/comment/{id}/
    activate V
        V -> R : objects.filter(reporter, target).exists()
        activate R
        R -> DB : SELECT 1 FROM custom_admin_report ...
        activate DB
        DB --> R : Boolean
        deactivate DB
        deactivate R
        
        alt Not Reported Yet
            V -> R : create(reporter, reason, status='pending')
            activate R
                R -> DB : INSERT custom_admin_report
                activate DB
                DB --> R : Success
                deactivate DB
            deactivate R
            V --> JS : JSON {success: true}
        else Already Reported
            V --> JS : JSON {success: false, error: 'Duplicate'}
        end
    deactivate V
    JS -> UI : Show Toast "Report Submitted"
deactivate JS
deactivate UI

@enduml

